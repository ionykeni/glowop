{
  "name": "Daily Logistics WhatsApp Summary",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_logistics_whatsapp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyLogisticsWhatsApp",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar resumen diario",
            "description": "08:00 Israel"
          }
        }
      }
    ]
  },
  "description": "Every day at 08:00 Israel time, builds a Hebrew logistics summary and sends it by WhatsApp"
}