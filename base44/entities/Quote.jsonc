{
  "name": "Quote",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "Canonical FK from Quote to Group; optional only during controlled preparation initialization"
    },
    "preparation_flow_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True only for records created by the controlled quote preparation flow"
    },
    "multi_option_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True when QuoteOption A and B have been materialized"
    },
    "approved_option_key": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "approved_option_total_price": {
      "type": "number"
    },
    "approved_option_snapshot": {
      "type": "string",
      "description": "Serialized immutable snapshot of the selected commercial option"
    },
    "group_name": {
      "type": "string",
      "description": "Optional operational group name, kept separate from client organization and contact person"
    },
    "quote_number": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SENT",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "default": "DRAFT"
    },
    "approved_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string"
    },
    "rejected_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "quote_type": {
      "type": "string",
      "enum": [
        "lodging",
        "day_use",
        "custom"
      ],
      "default": "lodging"
    },
    "quote_audience_type": {
      "type": "string",
      "enum": [
        "EDUCATION_STAFF",
        "STUDENTS",
        "SOCIAL_ORGANIZATIONS"
      ],
      "description": "Audience category controlling quote PDF subtitle and introduction"
    },
    "client_name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_tax_id": {
      "type": "string"
    },
    "client_notes": {
      "type": "string"
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "arrival_time": {
      "type": "string"
    },
    "departure_time": {
      "type": "string"
    },
    "nights": {
      "type": "number"
    },
    "estimated_pax": {
      "type": "number"
    },
    "staff_count": {
      "type": "number"
    },
    "participant_count": {
      "type": "number"
    },
    "includes_prisa": {
      "type": "boolean",
      "default": false
    },
    "package_lines": {
      "type": "string"
    },
    "new_addon_lines": {
      "type": "string"
    },
    "student_lodging_lines": {
      "type": "string"
    },
    "adult_lodging_lines": {
      "type": "string"
    },
    "workshop_lines": {
      "type": "string"
    },
    "lecture_lines": {
      "type": "string"
    },
    "coffee_corner_pax": {
      "type": "number"
    },
    "addon_lines": {
      "type": "string"
    },
    "adjustment_lines": {
      "type": "string"
    },
    "surcharge_lines": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "discount_percent": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "advance_payment": {
      "type": "number"
    },
    "balance_payment": {
      "type": "number"
    },
    "requires_advance_payment": {
      "type": "boolean",
      "default": true,
      "description": "Whether this quote requires the fixed 30% advance payment"
    },
    "payment_terms": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "internal_notes": {
      "type": "string"
    },
    "snapshot": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "version"
  ]
}