{
  "name": "GroupScheduleItem",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "FK to Group"
    },
    "operational_group_profile_id": {
      "type": "string",
      "description": "FK to OperationalGroupProfile"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "activity_name": {
      "type": "string"
    },
    "requested_location": {
      "type": "string",
      "description": "Client general preference: \u05db\u05d9\u05ea\u05d4 / \u05de\u05ea\u05d7\u05dd \u05d7\u05d5\u05e5 / \u05de\u05d7\u05d5\u05e5 \u05dc\u05d7\u05d5\u05d5\u05d4 / \u05d0\u05d7\u05e8"
    },
    "activity_space_id": {
      "type": "string",
      "description": "FK to ActivitySpace \u2014 optional, assigned by admin"
    },
    "activity_space_code": {
      "type": "string",
      "description": "Derived code from ActivitySpace e.g. bunker_1 \u2014 set by backend on save"
    },
    "quote_item_id": {
      "type": "string",
      "description": "Stable reference to a quote lecture/workshop line. Nullable."
    },
    "split_group_id": {
      "type": "string",
      "description": "UUID shared by all GroupScheduleItems created in a single split operation. Nullable."
    },
    "split_index": {
      "type": "number",
      "description": "1-based position within the split group. Nullable."
    },
    "split_total": {
      "type": "number",
      "description": "Total number of spaces in the split group. Nullable."
    },
    "shared_activity_id": {
      "type": "string",
      "description": "UUID shared by all GroupScheduleItems that represent the same shared activity across multiple groups. Nullable."
    },
    "shared_activity_created_from_group_id": {
      "type": "string",
      "description": "FK to Group \u2014 the group from which this shared activity was originally created. Nullable."
    },
    "shared_activity_group_ids": {
      "type": "string",
      "description": "JSON array of all group_ids participating in this shared activity \u2014 display snapshot only. Nullable."
    },
    "shared_activity_group_names": {
      "type": "string",
      "description": "JSON array of all group_names participating in this shared activity \u2014 display snapshot only. Nullable."
    },
    "is_shared_activity": {
      "type": "boolean",
      "description": "True when this item is part of a shared activity across multiple groups.",
      "default": false
    },
    "pax": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "needs_projector": {
      "type": "boolean",
      "default": false,
      "description": "Logistical need: projector"
    },
    "needs_screen": {
      "type": "boolean",
      "default": false,
      "description": "Logistical need: screen"
    },
    "needs_microphone": {
      "type": "boolean",
      "default": false,
      "description": "Logistical need: microphone"
    },
    "needs_sound": {
      "type": "boolean",
      "default": false,
      "description": "Logistical need: sound system"
    },
    "needs_whiteboard": {
      "type": "boolean",
      "default": false,
      "description": "Logistical need: whiteboard"
    },
    "needs_chair_circle": {
      "type": "boolean",
      "default": false,
      "description": "Logistical need: chair circle"
    },
    "chairs_count": {
      "type": "number",
      "description": "Number of chairs needed"
    },
    "logistics_other": {
      "type": "string",
      "description": "Other logistical needs (free text)"
    },
    "source": {
      "type": "string",
      "enum": [
        "groupSync",
        "manual"
      ],
      "description": "groupSync = prefilled from GuestForm; manual = added by admin"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CANCELLED"
      ],
      "default": "ACTIVE"
    }
  },
  "required": [
    "group_id",
    "operational_group_profile_id",
    "date",
    "start_time",
    "end_time",
    "activity_name",
    "source",
    "status"
  ]
}