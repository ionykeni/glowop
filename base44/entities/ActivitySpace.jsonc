{
  "name": "ActivitySpace",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Canonical code e.g. bunker_1, ohel_moed, boulder_1"
    },
    "name": {
      "type": "string",
      "description": "Hebrew display name"
    },
    "space_type": {
      "type": "string",
      "enum": [
        "BUNKER",
        "OHEL_MOED",
        "DINING_HALL",
        "FIREPLACE"
      ],
      "default": "BUNKER"
    },
    "capacity": {
      "type": "number"
    },
    "is_bookable": {
      "type": "boolean",
      "default": true
    },
    "mechina_requests_enabled": {
      "type": "boolean",
      "description": "Optional Mechina-only request eligibility. Unset preserves legacy code restrictions. Only the authorized backend operation may change this field.",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "working_status": {
      "type": "string",
      "enum": [
        "WORKING",
        "BROKEN",
        "MAINTENANCE",
        "CLOSED"
      ],
      "default": "WORKING"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name",
    "space_type"
  ],
  "rls": {
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}