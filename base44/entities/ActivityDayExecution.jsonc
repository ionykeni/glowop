{
  "name": "ActivityDayExecution",
  "type": "object",
  "properties": {
    "execution_key": {
      "type": "string",
      "description": "Client-generated UUID identifying one confirmed execution (idempotency key)"
    },
    "request_fingerprint": {
      "type": "string",
      "description": "SHA-256 of the confirmed plan; a key reused with a different plan is rejected"
    },
    "template_id": {
      "type": "string"
    },
    "template_family_id": {
      "type": "string"
    },
    "template_version": {
      "type": "number"
    },
    "template_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "state": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "COMPLETED",
        "INCOMPLETE"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "IN_PROGRESS",
      "description": "C1 creation state only. Phase C2 management uses management_state."
    },
    "stations_json": {
      "type": "string",
      "description": "JSON array of stations: {station_id, title, space_id, space_name, space_code, start_time, end_time, shared_activity_id, logistics, groups:[{group_id, group_name}], items:{group_id: GroupScheduleItem id}, status?, cancelled_at?, cancelled_by?, original?}"
    },
    "warnings_json": {
      "type": "string",
      "description": "Nonblocking warnings (pending requests) at confirmation time"
    },
    "last_error": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "attempts": {
      "type": "number",
      "default": 1
    },
    "revision": {
      "type": "number",
      "description": "C2 optimistic-concurrency revision; incremented when a management operation starts"
    },
    "management_state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "UPDATING",
        "NEEDS_RECOVERY",
        "CANCELLED"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "gray"
      ],
      "description": "C2 management state; empty means ACTIVE"
    },
    "operation_id": {
      "type": "string",
      "description": "UUID of the C2 operation in progress; empty when none"
    },
    "operation_json": {
      "type": "string",
      "description": "JSON of the C2 operation in progress: {op_id, type: EDIT|CANCEL_STATION|CANCEL_DAY, station_id?, station_ids?, target?, previous?, started_at, by}"
    },
    "history_json": {
      "type": "string",
      "description": "JSON array of completed C2 operations (audit trail)"
    },
    "last_modified_at": {
      "type": "string"
    },
    "last_modified_by": {
      "type": "string"
    }
  },
  "required": [
    "execution_key",
    "template_id",
    "date",
    "state"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}