{
  "name": "SleepingAllocation",
  "type": "object",
  "properties": {
    "operational_group_profile_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "tent_id": {
      "type": "string"
    },
    "neighborhood_id": {
      "type": "string"
    },
    "stay_period_id": {
      "type": "string"
    },
    "allocation_series_id": {
      "type": "string"
    },
    "series_effective_from_period_id": {
      "type": "string"
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "allocated_pax": {
      "type": "number"
    },
    "allocation_type": {
      "type": "string",
      "enum": [
        "STUDENT",
        "STAFF"
      ]
    },
    "gender_group": {
      "type": "string",
      "enum": [
        "BOYS",
        "GIRLS",
        "MEN",
        "WOMEN",
        "MIXED"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CONFIRMED",
        "CANCELLED"
      ],
      "default": "DRAFT"
    },
    "housekeeping_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "READY",
        "ISSUE"
      ],
      "default": "PENDING"
    },
    "notes": {
      "type": "string"
    },
    "series_action": {
      "type": "string",
      "enum": [
        "RELEASE",
        "REASSIGN"
      ],
      "description": "Explicit cancellation/segment termination; never added to historical rows"
    },
    "series_action_date": {
      "type": "string",
      "format": "date"
    },
    "replacement_series_id": {
      "type": "string"
    },
    "source_allocation_id": {
      "type": "string",
      "description": "Original row replaced by this reassignment segment"
    },
    "segment_start_date": {
      "type": "string",
      "format": "date",
      "description": "Explicit start inside a stay period"
    },
    "segment_end_date": {
      "type": "string",
      "format": "date",
      "description": "Explicit retained segment end inside a stay period"
    },
    "released_helper_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "UI-only marker hiding a released allocation from the period re-add helper"
    },
    "released_helper_dismissed_at": {
      "type": "string",
      "description": "ISO datetime when the released helper item was dismissed"
    },
    "released_helper_dismissed_by": {
      "type": "string",
      "description": "Email of the user who dismissed the released helper item"
    }
  },
  "required": [
    "operational_group_profile_id",
    "group_id",
    "tent_id",
    "neighborhood_id",
    "arrival_date",
    "departure_date",
    "allocated_pax",
    "allocation_type",
    "gender_group",
    "status"
  ]
}