{
  "name": "CoffeeCornerRequest",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "FK to Group"
    },
    "operational_group_profile_id": {
      "type": "string",
      "description": "FK to OperationalGroupProfile"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "pax": {
      "type": "number"
    },
    "coffee_corner_type": {
      "type": "string",
      "enum": [
        "\u05e4\u05d9\u05e0\u05ea \u05e7\u05e4\u05d4 \u05e8\u05d2\u05d9\u05dc\u05d4",
        "\u05e4\u05d9\u05e0\u05ea \u05e7\u05e4\u05d4 \u05d5\u05e2\u05d5\u05d2\u05d9\u05d5\u05ea",
        "\u05e4\u05d9\u05e0\u05ea \u05e7\u05e4\u05d4 \u05d5\u05de\u05d0\u05e4\u05d4",
        "HOT_WATER_THERMOCAN_ONLY"
      ],
      "default": "\u05e4\u05d9\u05e0\u05ea \u05e7\u05e4\u05d4 \u05e8\u05d2\u05d9\u05dc\u05d4",
      "description": "\u05e1\u05d5\u05d2 \u05e4\u05d9\u05e0\u05ea \u05e7\u05e4\u05d4"
    },
    "location_id": {
      "type": "string",
      "description": "FK to ActivitySpace \u2014 optional, informational only"
    },
    "location_name_snapshot": {
      "type": "string",
      "description": "Hebrew visible name of the selected location, saved as text for reports"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "external_form"
      ],
      "default": "manual"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CANCELLED"
      ],
      "default": "ACTIVE"
    }
  },
  "required": [
    "group_id",
    "operational_group_profile_id",
    "date",
    "start_time",
    "end_time",
    "pax",
    "source",
    "status"
  ]
}