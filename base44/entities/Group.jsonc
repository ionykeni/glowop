{
  "name": "Group",
  "type": "object",
  "properties": {
    "group_name": {
      "type": "string",
      "description": "Group display name"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "LODGING",
        "DAY_USE"
      ],
      "default": "LODGING"
    },
    "stay_mode": {
      "type": "string",
      "enum": [
        "CONTINUOUS",
        "MULTI_PERIOD"
      ],
      "default": "CONTINUOUS"
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "arrival_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated arrival time on arrival day"
    },
    "departure_time": {
      "type": "string",
      "description": "HH:MM \u2014 estimated departure time on departure day"
    },
    "total_pax": {
      "type": "number"
    },
    "staff_count": {
      "type": "number"
    },
    "participant_count": {
      "type": "number"
    },
    "boys_count": {
      "type": "number"
    },
    "girls_count": {
      "type": "number"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "manual_creation_request_id": {
      "type": "string",
      "description": "Client request id used to make manual Group creation idempotent"
    },
    "quote_preparation_flow": {
      "type": "boolean",
      "default": false,
      "description": "Additive marker for groups created by the controlled quote preparation flow; Quote.group_id remains the canonical relationship"
    },
    "operationally_active": {
      "type": "boolean",
      "default": true,
      "description": "When false, the Group remains administratively available but is excluded from operational modules and calculations"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_APPROVAL",
        "CONFIRMED",
        "CANCELLED",
        "COMPLETED",
        "ARCHIVED"
      ],
      "default": "DRAFT"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO datetime \u2014 set when group is marked COMPLETED"
    },
    "archived_at": {
      "type": "string",
      "description": "ISO datetime \u2014 set when group is frozen/archived"
    },
    "archived_reason": {
      "type": "string",
      "description": "Reason for freezing/archiving the group"
    },
    "cancellation_operation_id": {
      "type": "string",
      "description": "QuoteCancellationAudit id holding the cancellation lock (atomic compare-and-set). Backend-only.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "backend_only"
          }
        }
      }
    }
  },
  "required": [
    "group_name",
    "group_type",
    "arrival_date",
    "status"
  ],
  "rls": {
    "update": {
      "data.status": {
        "$ne": "CANCELLED"
      }
    }
  }
}